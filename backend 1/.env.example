# Root containing one directory per SeriesInstanceUID.
KNEE_AI_STUDY_ROOT=D:/knee-mri/train_images
# CSV columns: StudyInstanceUID, SeriesInstanceUID, Fluid_Sensitive, Fat_Suppression
KNEE_AI_SERIES_METADATA_PATH=D:/knee-mri/train_series.csv
# Optional; defaults to the supplied canonical checkpoint next to this backend.
# KNEE_AI_CHECKPOINT_PATH=D:/secure-models/best_5slice_model.pth
# Optional; defaults to backend/knee_ai.db.
# KNEE_AI_DATABASE_URL=sqlite:///C:/path/to/knee_ai.db
# Secret used to sign bearer access tokens. Set a strong value outside local development.
# KNEE_AI_AUTH_SECRET=change-this-in-production
# Comma-separated browser origins allowed to call the API.
# KNEE_AI_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Required for report generation; export into the server process environment.
# This file is documentation and is not loaded automatically.
GEMINI_API_KEY=
# Optional; defaults to member2_llm beside backend 1 (independent of working directory).
# Overrides the default; supports ~. Relative overrides resolve from the server working directory.
# Set before starting the backend; restart after changes.
# KNEE_AI_MEMBER2_PATH=C:/path/to/member2_llm
# Optional; avoid creating Python bytecode caches during execution.
PYTHONDONTWRITEBYTECODE=1
