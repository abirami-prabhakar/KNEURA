# Copy to /etc/kneura/kneura.env, owned by root, mode 0600.
# systemd EnvironmentFile syntax: KEY=value, no export or shell expansion.
KNEURA_DATA_DIR=/var/lib/kneura
KNEURA_CHECKPOINT=/opt/kneura/model/checkpoint.pt
KNEURA_ORIGINS=https://kneura.example.com
KNEURA_SECURE_COOKIE=1
LLM_PROVIDER=Google Gemini
KNEURA_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
KNEURA_LLM_MODEL=REPLACE_WITH_YOUR_APPROVED_MODEL
KNEURA_LLM_KEY=REPLACE_WITH_YOUR_PRIVATE_KEY
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
